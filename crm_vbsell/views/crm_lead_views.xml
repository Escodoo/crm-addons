<odoo>
    <record id="crm_lead_view_form_vbsell" model="ir.ui.view">
        <field name="name">crm.lead.form.vbsell</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="VBSell" name="vbsell">
                    <group>
                        <field name="vbsell_opportunity_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
