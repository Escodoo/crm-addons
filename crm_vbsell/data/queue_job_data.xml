<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="channel_vbsell" model="queue.job.channel">
        <field name="name">vbsell</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>
    <record id="job_function_crm_lead_vbsell_push_stage" model="queue.job.function">
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="method">_vbsell_push_stage</field>
        <field name="channel_id" ref="channel_vbsell" />
        <field name="retry_pattern" eval="{1: 60, 2: 300, 3: 900, 5: 3600}" />
    </record>
</odoo>
