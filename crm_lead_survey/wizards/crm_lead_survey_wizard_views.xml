<odoo>

    <record id="crm_lead_survey_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.lead.survey.wizard.form</field>
        <field name="model">crm.lead.survey.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Survey">
                <group>
                    <field name="lead_id" readonly="1" options="{'no_open': True}" />
                    <field name="survey_id" options="{'no_create_edit': True}" />
                    <field name="start_now" />
                    <field
                        name="partner_id"
                        options="{'no_create_edit': True}"
                        attrs="{'invisible': [('start_now', '=', True)]}"
                    />
                    <field
                        name="deadline"
                        attrs="{'invisible': [('start_now', '=', True)]}"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Start Survey"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="crm_lead_survey_wizard_action" model="ir.actions.act_window">
        <field name="name">Start Survey</field>
        <field name="res_model">crm.lead.survey.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_lead_survey_wizard_view_form" />
        <field name="target">new</field>
    </record>

</odoo>
