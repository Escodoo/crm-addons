<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crm.vbsell.cnpj.search</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm_vbsell.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='vbsell_min_create_stage']/parent::div"
                position="after"
            >
                <div class="row">
                    <label for="vbsell_cnpj_search" class="col-lg-4 o_light_label" />
                    <div class="col-lg-8">
                        <field name="vbsell_cnpj_search" class="oe_inline" />
                        <div class="text-muted">
                            Fill the company from the Brazilian CNPJ service.
                            A company that already has a legal name is not
                            queried again.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
